{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": ".local/test-build",
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "src/hand-coach.ts",
    "src/lesson-flow.ts",
    "src/motion.ts",
    "src/persona.ts"
  ]
}
