<style>
 .root { flex-direction: column; width: 160; padding-top: 4; padding-bottom: 4; padding-left: 5; padding-right: 5; gap: 1.7; background-color: #f5f0e4; border-radius: 4; }
 .eyebrow { color: #397365; font-size: 2.5; font-weight: 700; }
 .title { color: #102f36; font-size: 6; font-weight: 700; }
 .body { color: #254749; font-size: 3.5; }
 .small { color: #415e5f; font-size: 2.7; }
 .step-title { color: #153f47; font-size: 4.3; font-weight: 700; }
 .row { flex-direction: row; gap: 2; }
 .choice { width: 35.5; height: 9; justify-content: center; align-items: center; background-color: #e4e5d9; border-radius: 1.5; color: #173f3e; font-size: 3; cursor: pointer; }
 .primary { width: 150; height: 12; justify-content: center; align-items: center; background-color: #153f47; border-radius: 2; color: #fff8e8; font-size: 4.1; font-weight: 700; cursor: pointer; }
 .action { width: 74; height: 9; justify-content: center; align-items: center; background-color: #e1e5d9; border-radius: 1.5; color: #204347; font-size: 3.1; cursor: pointer; }
 .third { width: 48.6; height: 9; justify-content: center; align-items: center; background-color: #e1e5d9; border-radius: 1.5; color: #204347; font-size: 2.9; cursor: pointer; }
 .bar { width: 48.6; height: 1.5; background-color: #d9dfd5; border-radius: 0.6; }
 .status { height: 46; background-color: #e2eddf; border-radius: 2; padding-top: 3; padding-bottom: 3; padding-left: 3; padding-right: 3; flex-direction: column; gap: 1.4; }
 .status-heading { color: #163d3c; font-size: 4.4; font-weight: 700; }
 .hold-track { width: 144; height: 1.5; background-color: #cdd8c7; border-radius: 0.6; }
 .hold-fill { width: 0%; height: 1.5; background-color: #34795c; border-radius: 0.6; }
 .legend-left { width: 71; color: #744119; font-size: 3.3; }
 .legend-right { width: 71; color: #1f6653; font-size: 3.3; }
 .options { flex-direction: column; gap: 2; display: none; }
 .message { color: #385a50; font-size: 2.7; height: 7; }
</style>
<div class="root">
 <div class="eyebrow">FOLK / MOTION STUDIO</div>
 <div class="title" id="MoveTitle">Flash step</div>
 <div class="small" id="Tradition">Shan shen bu / Anhui Flower Drum Lantern</div>
 <div class="row">
  <button class="choice" id="Move0">01 / Flash step</button>
  <button class="choice" id="Move1">02 / Ball kick</button>
  <button class="choice" id="Move2">03 / Bear shake</button>
  <button class="choice" id="Move3">04 / Head shake</button>
 </div>
 <div class="row" style="justify-content: space-between">
  <div class="small" id="Progress">0 / 3 explored</div>
  <div class="small" id="Timeline">0.0s / 0.5x</div>
 </div>
 <div class="row"><div id="Step0" class="bar"></div><div id="Step1" class="bar"></div><div id="Step2" class="bar"></div></div>
 <div class="step-title" id="StepTitle">1 / 3 Reach across</div>
 <div class="body" id="Cue">Copy the arm outline. One hand reaches farther to the side.</div>
 <div class="status" id="StatusBlock">
  <div class="status-heading" id="Status">PREPARING YOUR STUDIO</div>
  <div class="body" id="Instruction">Watch a phrase. Copy three shapes at your own pace.</div>
  <div class="small" id="Tracking">Footwork is a visual reference.</div>
  <div class="row"><div class="legend-left" id="LeftCue">Peach = your left</div><div class="legend-right" id="RightCue">Mint = your right</div></div>
  <div class="small" id="Hold">Hands optional / self-confirmation available</div>
  <div class="hold-track"><div id="HoldFill" class="hold-fill"></div></div>
 </div>
 <button class="primary" id="Primary">Start lesson</button>
 <button class="primary" id="Retry" style="display: none">Retry loading motion [Enter]</button>
 <div class="small" id="FootCue">Notice the changing foot placement. Keep your steps small.</div>
 <div class="row"><button class="action" id="Play">Watch phrase [Space]</button><button class="action" id="Options">More options</button></div>
 <div class="row"><button class="action" id="Calibrate">Calibrate hands [C]</button><button class="action" id="Reset">Restart lesson [R]</button></div>
 <div class="row"><button class="action" id="EnterXR">Enter headset</button><button class="action" id="ExitXR">Exit headset</button></div>
 <div class="options" id="OptionsBody">
  <div class="row"><button class="third" id="Previous">Previous shape</button><button class="third" id="Next">Next shape</button><button class="third" id="Practice">Copy this shape</button></div>
  <div class="row"><button class="action" id="Speed">Speed: 0.5x</button><button class="action" id="Sound">Sound cues: off</button></div>
  <button class="action" id="Mirror" style="width: 150">Mirror: follow like a reflection</button>
  <button class="action" id="ReducedMotion" style="width: 150">Auto demo: on</button>
  <div class="small" id="SourceInfo">Teaching reference. This is a 2D estimate.</div>
  <button class="action" id="Source" style="width: 150">Open teaching source</button>
  <div class="small">Progress stays on this device. Enter: lesson action / Arrows: shapes / 1-3: dances / M: mirror / Esc: pause.</div>
 </div>
 <div class="message" id="Message"></div>
 <div class="small">Clear space. Small movements. Footwork and balance are not measured. Hidden joints are omitted.</div>
</div>
